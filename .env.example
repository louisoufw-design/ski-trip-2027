# ------------------------------------------------------------
# 本專案目前「不需要」任何環境變數，網站可以直接開啟使用。
#
# 下面的變數只是保留給未來擴充，目前程式都不會讀取。
# 如果之後要用：複製這個檔案並改名為 .env，再填入真正的值。
# .env 已經列在 .gitignore，不會被上傳到 GitHub。
# ------------------------------------------------------------

# 本機伺服器的連接埠（選用）
PORT=8000

# 匯率 API 金鑰（未來若要自動更新日圓匯率時使用）
EXCHANGE_RATE_API_KEY=YOUR_API_KEY
